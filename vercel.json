{
  "version": 2,
  "builds": [
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "index1.html", "use": "@vercel/static" },
    { "src": "index2.html", "use": "@vercel/static" },
    { "src": "index3.html", "use": "@vercel/static" },
    { "src": "videos/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/go", "dest": "/api/go.js" },
    { "src": "/api/begin", "dest": "/api/begin.js" },
    { "src": "/api/check", "dest": "/api/check.js" },
    { "src": "/api/start", "dest": "/api/start.js" },
    { "src": "/api/step", "dest": "/api/step.js" },
    { "src": "/api/choose", "dest": "/api/choose.js" },
    { "src": "/api/verify", "dest": "/api/verify.js" },
    { "src": "/api/getkey", "dest": "/api/getkey.js" },
    { "src": "/api/checkkey", "dest": "/api/checkkey.js" },
    { "src": "/api/cron", "dest": "/api/cron.js" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/index1.html", "dest": "/index1.html" },
    { "src": "/index2.html", "dest": "/index2.html" },
    { "src": "/index3.html", "dest": "/index3.html" },
    { "src": "/videos/(.*)", "dest": "/videos/$1" },
    { "src": "/sw.js", "dest": "/sw.js" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 0 * * *" }
  ]
}
